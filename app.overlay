&pinctrl{
    nrf_default: nrf_default {
            group1 {
                pinmux = <SPIM2_MISO_GPIO12>,
                    <SPIM2_SCLK_GPIO14>,
                    <SPIM2_CSEL_GPIO15>;
            };

            group2 {
                pinmux = <SPIM2_MOSI_GPIO13>;
                output-low;
            };
    };
};

&spi2{
    #address-cells = <1>;
    #size-cells = <0>;
    status = "okay";
    cs-gpios = <&gpio0 15 GPIO_ACTIVE_LOW>;
    pinctrl-0 = <&nrf_default>;
    pinctrl-names = "default";

    nrf24l01:nrf24l01@0{
        compatible = "ziq,nrf24l01";
        reg = <0>;
        spi-max-frequency= <1000000>;
        chip-en-gpios = <&gpio0 16 GPIO_ACTIVE_LOW>;
    };
};

